# --- Phase 1: Security & Core Architecture ------------------------------

# Real backend auth (NextAuth v5 / Auth.js). Restricts sign-in to explicit
# GrowForge team emails — Google OAuth confirms identity, this list decides
# who's let in at all. Comma-separated, no spaces required around commas.
AUTHORIZED_EMAILS=you@growforgedigital.com,teammate@growforgedigital.com

# Subset of AUTHORIZED_EMAILS granted the "owner" role (credential vault
# management, department PIN bypass). Must also appear in AUTHORIZED_EMAILS.
OWNER_EMAILS=you@growforgedigital.com

# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session/JWT signing secret. Generate with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Master key for the server-side encrypted credential vault (AES-256-GCM).
# Must be a 64-character hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates every key already stored in data/vault.json.
VAULT_MASTER_KEY=

# --- AI Assistant / intent router. ---------------------------------------
#
# LLM_STRATEGY picks which provider(s) the router uses:
#   auto  (default) — try local Ollama first, fail over to Gemini, then Groq.
#                      Never errors as long as one of the three is reachable.
#   local            — Ollama only.
#   cloud            — Gemini if GEMINI_API_KEY is set, else Groq. Errors if
#                       neither key is set.
#
# This can also be changed live (no restart) via the strategy switcher in the
# chat UI, or PATCH /api/router {"strategy": "auto"|"local"|"cloud"}.
LLM_STRATEGY=auto

# JOB_PREFER_CLOUD: in "auto" strategy, real job work (department drafts,
# HQ/QA/final, the tool-execution loop) normally still prefers cloud models
# over free local Ollama for quality — but only when JOB_PREFER_CLOUD=true.
# Default is false (local-first, zero cost) — this project currently runs on
# local Ollama for job work since there's no OpenRouter budget (2026-09-23).
# Flip to true once cloud spend is affordable again; no code change needed.
JOB_PREFER_CLOUD=false

# Google AI Studio (free tier, no credit card required)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier, no credit card required)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenRouter — free account, no card needed. Hosts several genuinely free
# (rate-limited) models under a ":free" suffix alongside paid ones — check
# https://openrouter.ai/models?max_price=0 for the current free list, it
# changes over time. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# All five cloud keys above can also be set live from Settings -> Integrations
# once the app is running (stored in the encrypted server vault) — these env
# vars are just the deploy-time default; the vault value wins if both exist.

# Local Ollama — requires `ollama serve` running with the model pulled
# (`ollama pull qwen2.5:7b-instruct`). Needs ~5GB RAM/VRAM; on an 8GB-VRAM
# GPU or better this runs at usable speed. Meaningfully stronger than the
# 1B/3B llama models at following the department-agent prompts in this app.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Local free agent tools (src/lib/tools/) --------------------------------

# Piper text-to-speech — https://github.com/rhasspy/piper. Free, offline,
# fast enough to run fresh per call. Download a voice model (a .onnx file
# plus its matching .onnx.json) and point PIPER_MODEL_PATH at the .onnx file.
# Without this set, the synthesize_voice tool reports setup instructions
# instead of failing opaquely.
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=
PIPER_OUTPUT_DIR=

# whisper.cpp transcription — https://github.com/ggerganov/whisper.cpp. Free,
# offline. Run its `server` example (e.g. `./server -m models/ggml-base.en.bin`)
# rather than the CLI — model load is expensive, so a persistent server keeps
# it warm. Only files inside WHISPER_AUDIO_DIR (default: the same directory
# Piper writes to) can be transcribed — the transcribe_audio tool rejects
# anything else, since the filename is model-chosen, not user-supplied.
WHISPER_SERVER_URL=http://localhost:8080
WHISPER_AUDIO_DIR=

# ComfyUI image generation — https://github.com/comfyanonymous/ComfyUI. Free,
# offline, GPU-bound. Install it, download ONE checkpoint into its
# models/checkpoints folder, run it (`python main.py`), then set
# COMFYUI_CHECKPOINT to that checkpoint's exact filename — required, no
# sensible default since it's whatever file you downloaded.
COMFYUI_SERVER_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
COMFYUI_OUTPUT_DIR=

# Two presets — uncomment ONE block matching your checkpoint type. Defaults
# below (if you set neither) are the Turbo preset, tuned for modest VRAM
# (8GB) at 1024x1024. A full non-distilled SDXL checkpoint at these settings
# will look undercooked — use the SD1.5 preset's step/cfg values instead.

# SDXL-Turbo / SDXL-Lightning (fast, few steps, low cfg) — default:
COMFYUI_STEPS=8
COMFYUI_CFG=1.5
COMFYUI_SAMPLER=euler_ancestral
COMFYUI_SCHEDULER=sgm_uniform
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024

# SD1.5 (standard, more steps, higher cfg) — comment out the block above and
# uncomment this one instead if your checkpoint is a plain SD1.5 model:
# COMFYUI_STEPS=25
# COMFYUI_CFG=7
# COMFYUI_SAMPLER=euler
# COMFYUI_SCHEDULER=normal
# COMFYUI_WIDTH=512
# COMFYUI_HEIGHT=512

# n8n autonomous workflow integration (src/lib/tools/n8n.ts)
# Point N8N_HOST to your local or hosted n8n instance (e.g. http://localhost:5678)
# and provide an API Key generated in n8n Settings -> n8n API.
N8N_HOST=http://localhost:5678
N8N_API_KEY=

# Self-hosted SearXNG search engine instance (src/lib/research.ts)
# Local fallback search provider when Gemini grounding quota is unavailable.
SEARXNG_BASE_URL=http://localhost:8088

