# AI Assistant / intent router.
#
# LLM_STRATEGY picks which provider(s) the router uses:
#   auto  (default) — try local Ollama first, fail over to Gemini, then Groq.
#                      Never errors as long as one of the three is reachable.
#   local            — Ollama only.
#   cloud            — Gemini if GEMINI_API_KEY is set, else Groq. Errors if
#                       neither key is set.
#
# This can also be changed live (no restart) via the strategy switcher in the
# chat UI, or PATCH /api/router {"strategy": "auto"|"local"|"cloud"}.
LLM_STRATEGY=auto

# Google AI Studio (free tier, no credit card required)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier, no credit card required)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama — requires `ollama serve` running with the model pulled
# (`ollama pull llama3.2:1b`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
