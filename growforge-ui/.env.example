# --- Phase 1: Security & Core Architecture ------------------------------

# Real backend auth (NextAuth v5 / Auth.js). Restricts sign-in to explicit
# GrowForge team emails — Google OAuth confirms identity, this list decides
# who's let in at all. Comma-separated, no spaces required around commas.
AUTHORIZED_EMAILS=you@growforgedigital.com,teammate@growforgedigital.com

# Subset of AUTHORIZED_EMAILS granted the "owner" role (credential vault
# management, department PIN bypass). Must also appear in AUTHORIZED_EMAILS.
OWNER_EMAILS=you@growforgedigital.com

# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session/JWT signing secret. Generate with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Master key for the server-side encrypted credential vault (AES-256-GCM).
# Must be a 64-character hex string (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates every key already stored in data/vault.json.
VAULT_MASTER_KEY=

# --- AI Assistant / intent router. ---------------------------------------
#
# LLM_STRATEGY picks which provider(s) the router uses:
#   auto  (default) — try local Ollama first, fail over to Gemini, then Groq.
#                      Never errors as long as one of the three is reachable.
#   local            — Ollama only.
#   cloud            — Gemini if GEMINI_API_KEY is set, else Groq. Errors if
#                       neither key is set.
#
# This can also be changed live (no restart) via the strategy switcher in the
# chat UI, or PATCH /api/router {"strategy": "auto"|"local"|"cloud"}.
LLM_STRATEGY=auto

# Google AI Studio (free tier, no credit card required)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier, no credit card required)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# All four cloud keys above can also be set live from Settings -> Integrations
# once the app is running (stored in the encrypted server vault) — these env
# vars are just the deploy-time default; the vault value wins if both exist.

# Local Ollama — requires `ollama serve` running with the model pulled
# (`ollama pull llama3.2:1b`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
