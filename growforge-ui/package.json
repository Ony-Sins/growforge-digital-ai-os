{
  "name": "growforge-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docs:brain": "npx tsx scripts/generate-brain-docs.ts",
    "backtest": "npx tsx scripts/backtest.ts",
    "test:mcp": "npx tsx scripts/test-mcp-gemini-e2e.ts",
    "cf:dev": "vite dev --port 3001",
    "cf:build": "vite build",
    "cf:preview": "vite build && wrangler dev --port 8787 --local-protocol https",
    "cf:types": "wrangler types cloudflare-env.d.ts --include-runtime=false --env-file .dev.vars.example && node -e \"const f=require('fs'),p='cloudflare-env.d.ts';f.writeFileSync(p,f.readFileSync(p,'utf8').replace(/type StringifyValues[^]*$/,''))\"",
    "cf:deploy": "vite build && wrangler deploy",
    "dev:owner-review": "node scripts/owner-review/launch.mjs",
    "owner-review:project": "node scripts/owner-review/build-projection.mjs",
    "owner-review:verify": "node scripts/owner-review/verify.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@receptron/laya": "^0.1.1",
    "@types/three": "^0.186.0",
    "@xyflow/react": "^12.11.6",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.45.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.2.8",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0",
    "three-forcegraph": "^1.43.4",
    "vinext": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "wrangler": "^4.144.0"
  },
  "type": "module"
}
